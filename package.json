{
  "name": "teste-tecnico-chico-rei",
  "version": "1.0.0",
  "private": true,
  "description": "Mini loja virtual em Vue 2.7 inspirada na vitrine de umapenca.com/loja",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
